{
  "name": "pitch",
  "productName": "Pitch",
  "version": "0.1.0",
  "description": "Launcher para juegos de Scratch exportados como apps de escritorio, con actualizaciones automáticas desde GitHub Releases.",
  "main": "src/main/main.js",
  "author": "Roud",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "electron-updater": "^6.6.2",
    "extract-zip": "^2.0.1",
    "semver": "^7.8.5",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@turbowarp/scaffolding": "^0.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.roud.pitch",
    "productName": "Pitch",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "pitch.config.json",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Pitch usa el micrófono solo para las llamadas de Discord del panel lateral.",
        "NSCameraUsageDescription": "Pitch usa la cámara solo para las videollamadas de Discord del panel lateral."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "maintainer": "Roud <roud@example.com>"
    },
    "artifactName": "Pitch-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "planeador4000-design",
        "repo": "pitch",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/planeador4000-design/pitch.git"
  }
}
